{
  "redirects": [
    { "source": "/shipment-tracker", "has": [{ "type": "query", "key": "token", "value": "(?<token>.*)" }], "destination": "/customer/:token", "permanent": true },
    { "source": "/shipment-tracker/", "has": [{ "type": "query", "key": "token", "value": "(?<token>.*)" }], "destination": "/customer/:token", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
